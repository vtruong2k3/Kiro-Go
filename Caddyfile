# Kiro-Go API Gateway — https://api.botlease.click
api.botlease.click {
    reverse_proxy kiro-go:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}

        transport http {
            response_header_timeout 0
        }
        flush_interval -1
    }

    request_body {
        max_size 20MB
    }

    encode gzip

    log {
        output file /var/log/caddy/api.botlease.click.log {
            roll_size 10MB
            roll_keep 5
        }
    }
}
